graph TD
    %% APF Color Palette
    classDef agent fill:#0f5132,stroke:#0dfd8a,stroke-width:2px,color:#fff,rx:5px,ry:5px

    subgraph "🤖 LANE: AGENT"
        BUILD["🏗️ builder: Implement code"]:::agent
        REV["🛡️ reviewer: Audit code"]:::agent
    end
    
    BUILD -->|BuildEnvelope| REV
    REV -.->|Fail: review notes| BUILD
