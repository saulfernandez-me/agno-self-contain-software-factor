graph TD
    %% APF Color Palette
    classDef agent fill:#0f5132,stroke:#0dfd8a,stroke-width:2px,color:#fff,rx:5px,ry:5px
    classDef code fill:#2d1b22,stroke:#ff4d4f,stroke-width:2px,color:#fff,stroke-dasharray:5 5,rx:3px,ry:3px

    subgraph "🤖 LANE: AGENT"
        PO["🛡️ reviewer: Product Analysis & MVP Scope"]:::agent
        SM["📐 planner: Atomic Issue Breakdown"]:::agent
    end

    subgraph "⚙️ LANE: CODE"
        API["✅ run_shell: gh issue create"]:::code
    end

    PO -->|ProductAnalysisEnvelope| SM
    SM -->|BacklogEnvelope| API
