graph TD
    %% APF Color Palette
    classDef agent fill:#0f5132,stroke:#0dfd8a,stroke-width:2px,color:#fff,rx:5px,ry:5px
    classDef code fill:#2d1b22,stroke:#ff4d4f,stroke-width:2px,color:#fff,stroke-dasharray:5 5,rx:3px,ry:3px
    classDef human fill:#1a365d,stroke:#3182ce,stroke-width:2px,color:#fff,rx:5px,ry:5px

    subgraph "🤖 LANE: AGENT"
        SCOUT["🔍 scout: Reproduce bug & gather logs"]:::agent
        BUILD["🏗️ builder: Apply fix"]:::agent
    end

    subgraph "⚙️ LANE: CODE"
        TEST{"✅ run_shell: pytest tests/test_bug.py"}:::code
    end

    subgraph "👤 LANE: ENGINEER"
        HITL["⚠️ Escalation: Unfixable Bug"]:::human
    end

    SCOUT -->|ScoutEnvelope| BUILD
    BUILD -->|BuildEnvelope| TEST
    
    TEST -.->|Fail: stderr| BUILD
    TEST -->|Fail: Max Attempts| HITL
