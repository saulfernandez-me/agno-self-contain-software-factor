graph TD
    %% APF Color Palette
    classDef agent fill:#0f5132,stroke:#0dfd8a,stroke-width:2px,color:#fff,rx:5px,ry:5px
    classDef code fill:#2d1b22,stroke:#ff4d4f,stroke-width:2px,color:#fff,stroke-dasharray:5 5,rx:3px,ry:3px

    subgraph "🤖 LANE: AGENT"
        PLAN["📐 planner: Create plan"]:::agent
        BUILD["🏗️ builder: Implement code"]:::agent
    end
    
    subgraph "⚙️ LANE: CODE"
        LINT{"✅ run_shell: ruff check"}:::code
        TEST{"✅ run_shell: pytest"}:::code
    end
    
    PLAN -->|PlanEnvelope| BUILD
    BUILD -->|BuildEnvelope| LINT
    LINT -.->|Fail: stderr| BUILD
    LINT -->|Pass| TEST
    TEST -.->|Fail: stderr| BUILD
