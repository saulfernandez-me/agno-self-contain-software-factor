graph TD
    %% Standard SDLC: Plan -> Build -> Test -> Review

    subgraph "LANE: agent"
        PLAN["planner: Create PlanEnvelope"]:::agent
        BUILD["builder: Create BuildEnvelope"]:::agent
        REVIEW["reviewer: Create ReviewEnvelope"]:::agent
    end

    subgraph "LANE: code"
        GATE_PLAN["assert_schema_valid: plan.json"]:::code
        GATE_TEST["run_shell_command: pytest"]:::code
    end

    subgraph "LANE: engineer"
        HITL["Escalation: Manual PR Review"]:::human
    end

    %% Execution Flow
    PLAN --> GATE_PLAN
    GATE_PLAN -->|Pass| BUILD
    BUILD --> GATE_TEST
    
    %% Correction Loop
    GATE_TEST -.->|Fail: Re-prompt In-Session| BUILD
    
    %% Success Path
    GATE_TEST -->|Pass| REVIEW
    REVIEW --> HITL
