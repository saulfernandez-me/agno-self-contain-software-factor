graph TD
    %% Bug Fix Loop: Reproduce -> Fix -> Test

    subgraph "LANE: agent"
        SCOUT["scout: Reproduce bug & gather logs"]:::agent
        BUILD["builder: Apply fix"]:::agent
    end

    subgraph "LANE: code"
        GATE_REPRO["assert_file_not_empty: reproduction.json"]:::code
        GATE_TEST["run_shell_command: pytest tests/test_bug.py"]:::code
    end

    subgraph "LANE: engineer"
        HITL["Escalation: Unfixable Bug"]:::human
    end

    %% Execution Flow
    SCOUT --> GATE_REPRO
    GATE_REPRO -->|Pass| BUILD
    BUILD --> GATE_TEST
    
    %% Correction Loop
    GATE_TEST -.->|Fail: Re-prompt In-Session| BUILD
    GATE_TEST -->|Fail: Max Attempts| HITL
