graph TD
    subgraph "LANE: agent"
        PLAN["planner: Create Plan"]:::agent
        BUILD["builder: Implement Code"]:::agent
    end
    subgraph "LANE: code"
        TEST["run_shell_command: pytest"]:::code
        LINT["run_shell_command: ruff check"]:::code
    end
    PLAN --> BUILD
    BUILD --> LINT
    LINT -.->|Fail| BUILD
    LINT --> TEST
    TEST -.->|Fail| BUILD
